          },
          {
            "expression": "visible-ads.com/amazon-google-ads",
            "operator": "notContains"
          }
        ],
        "is_priority": false,
        "name": "Amazon Advertising"
      },
      {
        "filters": [
          {
            "expression": "visible-ads.com/meta-ads|visible-ads.com/paid-social",
