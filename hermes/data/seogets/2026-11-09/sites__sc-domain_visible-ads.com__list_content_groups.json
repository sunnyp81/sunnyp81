{
  "tool": "list_content_groups",
  "site": "sc-domain:visible-ads.com",
  "args": {},
  "data": {
    "content_groups": [
      {
        "filters": [
          {
            "expression": "https://visible-ads.com/|https://www.visible-ads.com/",
            "operator": "equals"
          }
        ],
        "is_priority": true,
        "name": "Homepage"
      },
      {
        "filters": [
          {
